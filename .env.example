# Server-only: Next.js proxies /api/* to your Express API (never exposed to the browser).
# Set in Vercel project settings or .env.local for local dev — do not commit real values.
API_URL=http://localhost:3001

# Public site URL (favicon: {WEBSITE_URL}/logo.png — place logo at public/logo.png)
WEBSITE_URL=http://localhost:3000
